# Sanity — create a free project at sanity.io/manage, copy the project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Editor token (Settings → API → Tokens, "Editor" role) — needed only for scripts/seed.ts
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity → Next.js revalidation webhook
SANITY_REVALIDATE_SECRET=change-me

# How YouTube blocks in articles render: "embed" (inline player) or "link" (styled link card)
NEXT_PUBLIC_VIDEO_MODE=embed

# Canonical site URL (used in metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Newsletter (Google Apps Script + Google Sheet) -----
# No Google Cloud project, service account, or key needed.
# See NEWSLETTER_SETUP.md for the click by click walkthrough.

# The Apps Script Web App deployment URL (ends in /exec).
SHEETS_WEBAPP_URL=

# A long random secret. Must match SHARED_SECRET inside the Apps Script.
SHEETS_WEBAPP_SECRET=

# Canonical site URL used on the unsubscribe pages (falls back to
# NEXT_PUBLIC_SITE_URL if unset).
SITE_URL=http://localhost:3000
